# Copy relevant values into Render's dashboard env vars (or a local .env if
# you use one) — none of these are required to run locally with defaults.

# Required in production (Render's blueprint auto-generates this)
DJANGO_SECRET_KEY=

# "True" locally (default), "False" in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames (Render's own domain is added
# automatically via RENDER_EXTERNAL_HOSTNAME, you only need this for a
# custom domain)
DJANGO_ALLOWED_HOSTS=

# Postgres connection string — Render sets this automatically when a
# database is attached to the web service via render.yaml
DATABASE_URL=

# Cloudinary media storage — from your Cloudinary dashboard's "API
# Environment variable" box, format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
