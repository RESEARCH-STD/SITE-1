# Settings come from environment variables. On PythonAnywhere, copy this file
# to `.env` next to manage.py and fill it in (settings.py reads it). None are
# needed to run locally with defaults.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# "True" locally (default), "False" in production
DJANGO_DEBUG=False

# Comma-separated list of the site's hostnames, e.g. <you>.eu.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# Postgres connection string, e.g. postgres://databridge:<password>@<host>:<port>/databridge
# (empty = local SQLite file db.sqlite3)
DATABASE_URL=

# Production behind a proxy (PythonAnywhere): if pages keep redirecting to
# themselves, tick "Force HTTPS" on the Web tab and set this to False.
DJANGO_SECURE_SSL_REDIRECT=True

# Outgoing email, used for password-reset links. While DJANGO_EMAIL_HOST is
# empty, emails only go to the log and "Forgot password?" links stay hidden.
# Any SMTP service works, e.g. Brevo (smtp-relay.brevo.com) or Resend.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL="Sustainable Solutions Tanzania <no-reply@example.org>"

# TakwimuBridge QDA (/qda/)
# Offer "Continue without an account" on the tool's sign-in page.
DJANGO_QDA_ALLOW_GUESTS=True
# Largest single project upload in MB, transcripts included.
DJANGO_QDA_MAX_UPLOAD_MB=30
